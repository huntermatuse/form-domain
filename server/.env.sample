# Required: HMAC signing key for login tokens (JWTs).
# Use a long, random string — e.g. `openssl rand -hex 64`
HMAC_KEY=some-really-really-long-key-here

# Required: Postgres connection URL.
DATABASE_URL=postgresql://admin:{password}@localhost:5432/app_db

# Optional: Directory for persistent application data storage outside Postgres.
# DATA_DIR=

# Optional: Host address the server will bind to.
# Use 0.0.0.0 to listen on all interfaces, or 127.0.0.1 to restrict to localhost only.
#HOST=0.0.0.0

# Optional: Port the server will listen on.
#PORT=13000


# Optional: Website Password used for development
WEBSITE_PASSWORD='some-password'
